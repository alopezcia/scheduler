# Misma base de datos SQLite que usa el backend (el backend es quien aplica las migraciones).
DATABASE_URL=sqlite://../backend/calendar.db
# Cada cuantos segundos se buscan tareas vencidas.
POLL_INTERVAL_SECONDS=5
# Un evento vencido hace mas de estos segundos ya no se ejecuta: se registra como `timeout`.
MAX_LATE_SECONDS=300
# Secretos de las conexiones REST: SCHEDULER_CRED_<credentials_ref en mayusculas, no alfanumericos -> _>
# bearer/api_key: el token. basic: usuario:contrasena.
# SCHEDULER_CRED_IGNITION_PROD=token-o-usuario:clave
