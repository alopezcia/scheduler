# Los ficheros usados dentro del contenedor Linux deben conservar saltos de línea LF
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf
docker/* text eol=lf

# Las migraciones de sqlx se validan por checksum de sus bytes: deben ser LF en cualquier SO
backend/migrations/*.sql text eol=lf
